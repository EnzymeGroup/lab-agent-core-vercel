{
  "name": "lab-agent-core-vercel-workspace",
  "version": "0.1.0-rc.3",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": {"node": ">=22.19.0"},
  "scripts": {
    "build:core": "npm run build -w lab-agent-core-vercel",
    "build:web": "npm run build -w @lab-agent/workbench && node scripts/bundle-web.mjs",
    "build:extras": "npm run build -w lab-agent-extras",
    "build": "npm run build:core && npm run build:extras && npm run build:web",
    "typecheck": "npm run typecheck -w lab-agent-core-vercel && npm run typecheck -w lab-agent-extras && npm run typecheck -w @lab-agent/workbench",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:extras": "node --test --test-concurrency=1 tests/extras/*.test.mjs",
    "test:consumers": "node --test --test-concurrency=1 tests/consumers/*.test.mjs",
    "test:browser": "playwright test",
    "test:live": "node --env-file-if-exists=.env scripts/live-smoke.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run test:extras && npm run test:consumers && node scripts/check-docs.mjs",
    "demo": "node scripts/demo.mjs",
    "pack:core": "node scripts/pack-core.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
